rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. User Profile: Only the owner can write; anyone can read public profiles.
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
      
      // Sub-collections (badges, titles)
      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // 2. Milestones: Global read, write for authenticated creators.
    match /milestones/{milestoneId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    // 3. Stats: Real-time trends.
    match /stats/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // 4. Notifications: Only receiver can read.
    match /notifications/{notifId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.receiverId;
      allow write: if request.auth != null;
    }
  }
}

