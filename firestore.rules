rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ----------------------------
    // Helpers
    // ----------------------------
    function isSignedIn() {
      return request.auth != null;
    }

    function userDoc(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && userDoc(request.auth.uid).data.role == 'admin';
    }

    // ----------------------------
    // users (fans / vtubers / admin profiles)
    // - doc id = auth uid
    // - public read when `isPublic==true`, otherwise only owner/admin
    // ----------------------------
    match /users/{uid} {
      allow read: if resource.data.isPublic == true
                   || (isSignedIn() && request.auth.uid == uid)
                   || isAdmin();
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update: if (isSignedIn() && request.auth.uid == uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // ----------------------------
    // vtubers (public profile documents)
    // ----------------------------
    match /vtubers/{vtuberId} {
      // public read (profile pages are public)
      allow read: if true;

      // create: signed-in user can create a profile that they own (document id equals creator uid)
      allow create: if isSignedIn() && (request.auth.uid == vtuberId || isAdmin());

      // update: owner can update most fields but must be the document owner (vtuberId)
      allow update: if isAdmin() || (isSignedIn()
        && request.auth.uid == vtuberId
        && ( !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid));

      allow delete: if isAdmin();
    }

    // ----------------------------
    // vtuber_profiles (canonical profile documents)
    // - doc id = auth uid
    // - public read for profile pages; writes only by owner/admin
    // ----------------------------
    match /vtuber_profiles/{uid} {
      allow read: if true;
      allow create: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow update: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow delete: if isAdmin();
    }

    // ----------------------------
    // handles (handle -> uid reverse index)
    // - public read (to resolve handles in public pages)
    // - create/update only when request.resource.data.uid == request.auth.uid
    // - delete only by owner or admin
    // ----------------------------
    match /handles/{handle} {
      allow read: if true;
      allow create: if isAdmin() || (isSignedIn() && ('uid' in request.resource.data && request.resource.data.uid == request.auth.uid));
      allow update: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid && ( !('uid' in request.resource.data) || request.resource.data.uid == resource.data.uid));
      allow delete: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
    }

    // ----------------------------
    // milestones (top-level collection)
    // - status enum: draft | published | active | achieved | archived | cancelled
    // - server-controlled fields: currentAmount, totalSupporters, achievedAt, archivedAt
    // ----------------------------
    match /milestones/{mid} {
      function milestoneTargetAmount(data) {
        return (data.targetAmount is number) ? data.targetAmount
          : (data.goal is number) ? data.goal
          : (data.target is number) ? data.target
          : 0;
      }

      function hasPublicMilestoneStatus() {
        return resource.data.get('status', '__missing__') in ['published','active','achieved','archived'];
      }

      function isMilestoneOwner() {
        return isSignedIn() && request.auth.uid == resource.data.get('vtuberId', '__missing__');
      }

      function isMilestoneCollaborator() {
        return isSignedIn() && (request.auth.uid in resource.data.get('collaborators', []));
      }

      // read: published/active/achieved/archived are readable by anyone; owner/admin can also read drafts
      allow read: if hasPublicMilestoneStatus()
                   || isAdmin()
                   || isMilestoneOwner()
                   || isMilestoneCollaborator();

      // create: owner (vtuberId) or admin can create; ensure server-controlled aggregations are not prefilled
      allow create: if isSignedIn()
            && (( 'vtuberId' in request.resource.data && request.auth.uid == request.resource.data.vtuberId) || isAdmin())
            && (!('currentAmount' in request.resource.data) || request.resource.data.currentAmount == 0)
            && (!('totalSupporters' in request.resource.data) || request.resource.data.totalSupporters == 0)
            && ( !('status' in request.resource.data) || request.resource.data.status in ['draft','published']);

      // update: admin can do anything; owner can update allowed non-server fields
      allow update: if isAdmin()
                    // 1) VTuber Owner update
                    || (isSignedIn() && request.auth.uid == resource.data.get('vtuberId', '__missing__')
                        && ( !('vtuberId' in request.resource.data) || request.resource.data.vtuberId == resource.data.get('vtuberId', '__missing__'))
                        // owner must not change server-controlled fields
                        && ( (!('currentAmount' in request.resource.data) || request.resource.data.currentAmount == resource.data.currentAmount)
                          && (!('totalSupporters' in request.resource.data) || request.resource.data.totalSupporters == resource.data.totalSupporters)
                          && (!('achievedAt' in request.resource.data)
                              || request.resource.data.achievedAt == resource.data.achievedAt
                              || request.resource.data.get('status', '') == 'achieved')
                          && (!('archivedAt' in request.resource.data) || request.resource.data.archivedAt == resource.data.archivedAt)
                        )
                        // owner may set status to draft/published, or achieved when fully funded
                        && ( !('status' in request.resource.data)
                             || request.resource.data.status in ['draft','published']
                             || request.resource.data.status == resource.data.get('status', '__missing__')
                             || (request.resource.data.status == 'achieved'
                                 && milestoneTargetAmount(resource.data) > 0
                                 && resource.data.get('currentAmount', 0) >= milestoneTargetAmount(resource.data))
                           )
                       )
                    // 2a) Fan sponsor update - normal progress update
                    || (isSignedIn() && request.auth.uid != resource.data.get('vtuberId', '__missing__')
                        // fan can only touch these specific fields during sponsorship
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentAmount', 'totalSupporters', 'updatedAt'])
                        // ensure they only increment
                        && request.resource.data.currentAmount >= resource.data.get('currentAmount', 0)
                        && request.resource.data.totalSupporters >= resource.data.get('totalSupporters', 0)
                       )
                    // 2b) Fan sponsor update - flip status to achieved when fully funded
                    || (isSignedIn() && request.auth.uid != resource.data.get('vtuberId', '__missing__')
                        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['currentAmount', 'totalSupporters', 'updatedAt', 'status', 'achievedAt'])
                        && request.resource.data.status == 'achieved'
                        && resource.data.get('status', '') != 'achieved'
                        && milestoneTargetAmount(resource.data) > 0
                        && request.resource.data.currentAmount >= milestoneTargetAmount(resource.data)
                        && request.resource.data.currentAmount >= resource.data.get('currentAmount', 0)
                        && request.resource.data.totalSupporters >= resource.data.get('totalSupporters', 0)
                       );

      // delete: allow admin, owner can delete drafts only
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.get('vtuberId', '__missing__') && resource.data.get('status', '__missing__') == 'draft');
    }

    // ----------------------------
    // contributions subcollection
    // - client may create a pending contribution
    // - only admin / server function (bypasses rules) may mark verified/success
    // ----------------------------
    match /milestones/{mid}/contributions/{cid} {
      // read: admin, contribution owner, or vtuber owner can read
      allow read: if isAdmin()
          || (isSignedIn() && (request.auth.uid == resource.data.userId || (exists(/databases/$(database)/documents/milestones/$(mid)) && request.auth.uid == get(/databases/$(database)/documents/milestones/$(mid)).data.vtuberId)));

      // create: signed-in fan can create a pending contribution for themselves
      allow create: if isSignedIn()
            && ('userId' in request.resource.data && request.auth.uid == request.resource.data.userId)
            && ('status' in request.resource.data && request.resource.data.status == 'pending')
            && ('amount' in request.resource.data && (request.resource.data.amount is number) && request.resource.data.amount > 0);

      // update: admin can update; contributor can only update non-sensitive fields (e.g., message) but not amount/status/userId
      allow update: if isAdmin()
            || (isSignedIn() && request.auth.uid == resource.data.userId
              && ( !('userId' in request.resource.data) || request.resource.data.userId == resource.data.userId)
              && ( !('amount' in request.resource.data) || request.resource.data.amount == resource.data.amount)
              && ( !('status' in request.resource.data) || request.resource.data.status == resource.data.status)
               );

      // delete: admin or contributor (only pending) can delete
      allow delete: if isAdmin() || (isSignedIn() && request.auth.uid == resource.data.userId && resource.data.status == 'pending');
    }

    // ----------------------------
    // rankings (snapshot of top supporters)
    // - read public; write by admin or server-only processes
    // ----------------------------
    match /milestones/{mid}/rankings/{fanUid} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ----------------------------
    // posts under milestone
    // - owner/admin can read all statuses (including drafts)
    // - only published posts can be read by public/supporters
    // ----------------------------
    match /milestones/{mid}/posts/{postId} {
      function isMilestoneOwner() {
        return isSignedIn()
          && exists(/databases/$(database)/documents/milestones/$(mid))
          && request.auth.uid == get(/databases/$(database)/documents/milestones/$(mid)).data.vtuberId;
      }

      function isSupporterAllowed() {
        return isSignedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && (
            (('allowedUids' in resource.data) && (request.auth.uid in resource.data.allowedUids))
            || (('unlockedMilestones' in userDoc(request.auth.uid).data) && (mid in userDoc(request.auth.uid).data.unlockedMilestones))
          );
      }

      function isPublicPost() {
        return resource.data.status == 'published'
          && (
            (('visibility' in resource.data) && resource.data.visibility == 'public')
            || (!('visibility' in resource.data) && (!('isExclusive' in resource.data) || resource.data.isExclusive == false))
          );
      }

      function isSupporterPost() {
        return resource.data.status == 'published'
          && (
            (('visibility' in resource.data) && resource.data.visibility == 'supporters')
            || (!('visibility' in resource.data) && ('isExclusive' in resource.data) && resource.data.isExclusive == true)
          );
      }

      allow read: if isAdmin()
                   || isMilestoneOwner()
                   || isPublicPost()
                   || (isSupporterPost() && isSupporterAllowed());

      // create/update/delete: only vtuber owner or admin
      allow create, update, delete: if isAdmin() || isMilestoneOwner();
    }

    // ----------------------------
    // transactions (payment records)
    // - 粉絲可建立自己名下的交易（status 允許 pending 或 success，模擬用）
    // - status / rawPayload 的更新保留給 admin（未來接上真實付款 webhook）
    // ----------------------------
    match /transactions/{txId} {
      // 為了支援 A-Task 2b 的前端排行榜即時監聽，開放讀取成功的交易
      allow read: if isAdmin() 
                  || (isSignedIn() && (resource.data.get('fanUid', null) == request.auth.uid || resource.data.vtuberId == request.auth.uid))
                  || (resource.data.status == 'success');

      allow create: if
            // signed-in user must provide their own fanUid
            (isSignedIn()
              && ('fanUid' in request.resource.data && request.auth.uid == request.resource.data.fanUid)
            )
            // guest: no fanUid field required, just validate amount and status
            || (!isSignedIn()
              && !('fanUid' in request.resource.data)
            )
            // shared validations for both paths
            && ('status' in request.resource.data && request.resource.data.status in ['pending', 'success'])
            && ('amount' in request.resource.data && (request.resource.data.amount is number && request.resource.data.amount > 0))
            && request.resource.data.keys().hasOnly([
              'fanUid',
              'fanName',
              'fanAvatarUrl',
              'vtuberId',
              'milestoneId',
              'milestoneTitle',
              'amount',
              'method',
              'message',
              'status',
              'createdAt'
            ]);

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ----------------------------
    // platform/cms (single doc, e.g., /platform/cms)
    // ----------------------------
    match /platform/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ----------------------------
    // collected_emails
    // - allow anyone to create an email record for demo
    // ----------------------------
    match /collected_emails/{docId} {
      allow create: if true;
      allow read, update, delete: if isAdmin();
    }

    // ----------------------------
    // Fallback deny
    // ----------------------------
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
