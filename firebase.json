{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/fan_profile",
        "destination": "/fan_profile.html"
      },
      {
        "source": "/vtuber_profile",
        "destination": "/vtuber_profile.html"
      }
    ]
  }
}
