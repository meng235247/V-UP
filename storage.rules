rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAllowedVTuber() {
      return request.auth != null && (
        request.auth.uid == '1rSsnLKbbrOSIuu9r0V1KR0v9FH2' ||
        request.auth.uid == 'A9LZXl3rsadyvPoxXYspfM6wPXD3' ||
        request.auth.uid == 'FSoqazbSyzL7Aa3jjxZWhOx145b2'
      );
    }

    function signedIn() {
      // Demo phase restrict: only whitelist can upload
      return isAllowedVTuber();
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isAllowedContentType() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|webp)')
        || request.resource.contentType.matches('audio/(mpeg|mp3)')
        || request.resource.contentType == 'video/mp4';
    }

    function maxSize(mb) {
      return request.resource.size < (mb * 1024 * 1024);
    }

    // ------------------------------------------------------------------
    // uploads/{uid}/... — 一般用戶上傳區
    // 公開讀取（Firebase Storage 下載 URL 包含 access token，不易被枚舉）
    // 只有本人才能寫入自己的 UID 子目錄，防止互相覆蓋
    // ------------------------------------------------------------------
    match /uploads/{uid}/{allPaths=**} {
      allow get: if true;          // 任何人可讀（含未登入訪客查看圖片）
      allow list: if false;        // 禁止列舉目錄（隱藏路徑結構）
      allow write: if isOwner(uid) && isAllowedContentType() && maxSize(5);
    }

    // ------------------------------------------------------------------
    // vtubers/{uid}/... — VTuber 個人素材區（橫幅、頭貼等）
    // 公開讀取；只有對應 UID 的 VTuber 才能上傳
    // ------------------------------------------------------------------
    match /vtubers/{uid}/{allPaths=**} {
      allow get: if true;          // 公開讀取
      allow list: if false;        // 禁止列舉
      allow write: if isOwner(uid) && isAllowedContentType() && maxSize(5);
    }
  }
}
