rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isAllowedContentType() {
      return request.resource.contentType.matches('image/(jpeg|jpg|png|webp)')
        || request.resource.contentType.matches('audio/(mpeg|mp3)')
        || request.resource.contentType == 'video/mp4';
    }

    function maxSize(mb) {
      return request.resource.size < (mb * 1024 * 1024);
    }

    match /uploads/{allPaths=**} {
      allow get: if true;
      allow list: if false;
      allow write: if signedIn() && isAllowedContentType() && maxSize(5);
    }

    match /vtubers/{uid}/{allPaths=**} {
      allow get: if true;
      allow list: if false;
      allow write: if signedIn() && request.auth.uid == uid && isAllowedContentType() && maxSize(5);
    }
  }
}
